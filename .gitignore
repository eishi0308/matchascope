# dependencies
node_modules/
frontend/node_modules/

# Next.js build output
.next/
frontend/.next/
out/

# env files
.env
.env.local
.env.*.local
frontend/.env.local
frontend/.env.*.local

# OS
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
backend/target/
backend/data/
backend/src/main/resources/application.properties

# Scraped page text and the input/output files of the render tools. All of it is
# regenerated by tools/render.mjs from the live sites, runs to megabytes, and changes
# on every crawl — the scripts are the source, not their output.
backend/tools/*.jsonl
backend/tools/*-targets.json
backend/tools/*-payload.json
backend/tools/*-retry.json
backend/tools/*-test*.json
backend/tools/td.json
backend/tools/ig-probe.json
backend/tools/node_modules/

# TypeScript incremental build cache
frontend/tsconfig.tsbuildinfo

backend/tools/offset.json
backend/tools/ddg.mjs
backend/tools/verify-attribution.mjs.log

# Crawl journals and per-run target lists. Regenerated by the tools in backend/tools,
# large, and meaningless without the run that produced them.
backend/tools/*.log
backend/tools/ig-*.json
backend/tools/step*-*.json
backend/tools/*-targets.json
backend/tools/bio-*.json
backend/tools/notopic-usable.json
backend/tools/supplier-handles.json
backend/tools/why-unread.csv
