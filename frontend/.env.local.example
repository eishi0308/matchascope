# Spring Boot backend URL (used by Next.js frontend)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Canonical production domain — used for sitemap.xml, robots.txt, canonical/OpenGraph
# URLs on cafe permalink pages, and share links. Set this to the real deployed domain;
# everything falls back to a placeholder otherwise (see src/lib/slug.ts).
NEXT_PUBLIC_SITE_URL=https://matchascope.com

# Basemap. Optional — the app ships with a keyless default (CARTO's Positron design,
# served as vector tiles by OpenFreeMap), so leave these unset and the map works.
#
# NEXT_PUBLIC_MAP_STYLE_URL — a different MapLibre style JSON.
# NEXT_PUBLIC_MAP_TILE_URL  — falls back to plain raster tiles instead. For CARTO with
#   an API key (carto.com, free, restrict it to your domain) that is:
#     NEXT_PUBLIC_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png?api_key=YOUR_KEY
#     NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>
